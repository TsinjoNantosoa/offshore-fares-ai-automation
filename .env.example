# =============================================================================
# Offshore Fares — AI Travel Operations Orchestrator
# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Secrets below are only read by the one-shot `n8n-init` container, which stores
# them as encrypted n8n Credentials. The running n8n workers never see them.
# =============================================================================

# --- n8n -----------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# 32+ random characters. Encrypts the credentials stored by n8n. Keep it stable!
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_VERSION=2.41.6
GENERIC_TIMEZONE=UTC
# Set to true to re-import workflows/credentials from ./n8n on next `docker compose up`
N8N_FORCE_REIMPORT=false

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=offshore_fares
POSTGRES_USER=offshore
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_PORT=5432
# Read-only role used by the ops console dashboard
CONSOLE_DB_PASSWORD=change-me-console-password
# Load the fictional demo dataset (10 agencies, 20 contacts, 30 RFQs) on first start
LOAD_DEMO_DATA=true

# --- Ops console ---------------------------------------------------------------
CONSOLE_PORT=3000
# Shared secret between the ops console and the n8n operator webhooks (X-Ops-Token header)
OPS_API_TOKEN=change-me-ops-token
# Optional basic auth for the console (leave empty to disable on localhost)
CONSOLE_USER=
CONSOLE_PASSWORD=

# --- OpenAI --------------------------------------------------------------------
# Your key goes HERE only. Leave empty to run fully offline (set AI_PROVIDER=rules).
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Any chat model supporting Structured Outputs (json_schema). Reasoning models (gpt-5*, o*) are supported (temperature omitted).
OPENAI_MODEL=gpt-4.1-mini
# openai | rules  (rules = deterministic extraction only, no external calls)
AI_PROVIDER=openai
AI_CONFIDENCE_THRESHOLD=0.7

# --- Channels ------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta). Not needed in DEMO_MODE.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# App secret used to verify X-Hub-Signature-256 (mandatory when DEMO_MODE=false)
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
# Approved template used for follow-ups outside the 24h customer-service window
WHATSAPP_FOLLOWUP_TEMPLATE=quote_followup
WHATSAPP_TEMPLATE_LANGUAGE=en

# Gmail OAuth client (Google Cloud console). Complete the OAuth sign-in in n8n afterwards.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Business behaviour ----------------------------------------------------------
# DEMO_MODE=true: Mock Fare Desk, simulated email/WhatsApp delivery, demo webhooks enabled
DEMO_MODE=true
REQUIRE_HUMAN_APPROVAL=true
AUTO_ACKNOWLEDGE=true
BUSINESS_TIMEZONE=UTC
COMPANY_SIGNATURE=Offshore Fares – Premium Fares Desk
CORRELATION_WINDOW_HOURS=72
CLARIFICATION_DEBOUNCE_SECONDS_WHATSAPP=45
CLARIFICATION_DEBOUNCE_SECONDS_EMAIL=0
MAX_CLARIFICATIONS=2
GROUP_MIN_PASSENGERS=10
# Optional JSON override of priority weights, e.g. {"BUSINESS":25,"VIP_AGENCY":20}
PRIORITY_RULES_JSON=

FOLLOWUP_1_HOURS=4
FOLLOWUP_2_HOURS=24
MAX_FOLLOWUPS=2

SLA_NEW_MINUTES=5
SLA_READY_FOR_SEARCH_MINUTES=10
SLA_ASSIGNED_MINUTES=15
SLA_SEARCHING_MINUTES=45
SLA_FARES_FOUND_MINUTES=10
SLA_PENDING_APPROVAL_MINUTES=10
SLA_BOOKING_REQUEST_MINUTES=5
SLA_CHANGE_REQUEST_MINUTES=15
SLA_REFUND_REQUEST_MINUTES=60
SLA_CRITICAL_FACTOR=0.5

# --- Optional ------------------------------------------------------------------
# Redis is not required by this POC (locking/idempotency are handled in PostgreSQL).
