        "query": "SELECT of_operator_action($1::jsonb) AS r;",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($json.db || {}) ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "ofPostgresCred01",
          "name": "Offshore Fares DB"
        }
      },
      "retryOnFail": true,
